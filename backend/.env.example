APP_NAME=Tusk
APP_MODE=dev
SERVER_PORT=8081
ALLOWED_ORIGINS=http://localhost:3000,http://example.com



DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tusk
DB_USER=root
DB_PASS=toor


ACCESS_TOKEN_TTL= "3600s"
JWT_SECRET=randomstring

# --- Mailer Configuration ---
MAIL_HOST=smtp.mailtrap.io   # Example: smtp.gmail.com, smtp.mailtrap.io
MAIL_PORT=2525               # Example: 587 (TLS), 465 (SSL), 2525 (Mailtrap)
MAIL_USERNAME=your_username  # Your SMTP username
MAIL_PASSWORD=your_password  # Your SMTP password
MAIL_SENDER=no-reply@tusk.com # The "From" email address

# --- SMS Provider Configuration ---
# Options: CONSOLE (Dev logging), HTTPSMS (Android SIM Gateway), AFRICAS_TALKING (Bulk SMS)
SMS_PROVIDER=CONSOLE

# httpSMS.com Configuration (Android SIM Gateway)
HTTPSMS_API_KEY=your_httpsms_api_key
HTTPSMS_FROM_PHONE=+254712345678

# Africa's Talking Configuration (Commercial Bulk SMS)
AT_USERNAME=sandbox
AT_API_KEY=your_africas_talking_api_key
AT_SENDER_ID=DAIRYSACCO
AT_IS_SANDBOX=true